{
  "rules": {
    "prefer-property-order": [
      "error",
      [
        "name",
        "version",
        "private",
        "description",
        "keywords",
        "homepage",
        "bugs",
        "repository",
        "funding",
        "author",
        "contributors",
        "license",
        "type",
        "source",
        "main",
        "module",
        "browser",
        "unpkg",
        "exports",
        "types",
        "typings",
        "bin",
        "man",
        "directories",
        "files",
        "sideEffects",
        "engines",
        "os",
        "cpu",
        "packageManager",
        "workspaces",
        "publishConfig",
        "scripts",
        "config",
        "dependencies",
        "peerDependencies",
        "peerDependenciesMeta",
        "devDependencies",
        "optionalDependencies",
        "bundledDependencies",
        "overrides",
        "resolutions",
        "browserslist",
        "prettier",
        "eslintConfig",
        "lint-staged",
        "husky"
      ]
    ],
    "require-name": "error",
    "require-version": "error",
    "require-description": "error",
    "require-license": "error",
    "require-repository": "error",
    "name-format": "error",
    "version-format": "error",
    "description-format": ["error", { "requireCapitalFirstLetter": true }],
    "valid-values-license": [
      "error",
      [
        "Apache-2.0",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "GPL-3.0-only",
        "GPL-3.0-or-later",
        "ISC",
        "MIT",
        "MPL-2.0",
        "UNLICENSED"
      ]
    ],
    "valid-values-private": ["error", [true, false]],
    "no-duplicate-properties": "error",
    "prefer-alphabetical-dependencies": "error",
    "prefer-alphabetical-devDependencies": "error"
  }
}
